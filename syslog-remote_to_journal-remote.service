[Unit]
Description=Forward syslog remote messages to systemd-journal-remote
Requires=systemd-journald.socket
Requires=systemd-journal-remote.socket
Requires=syslog-remote_to_journal-remote.socket
After=network.target

[Service]
Type=notify
ExecStart=/usr/local/sbin/syslog-remote_to_journal-remote
DynamicUser=on
ProtectSystem=full
ProtectHome=on
PrivateDevices=on
NoNewPrivileges=on

DevicePolicy=closed
ProtectSystem=strict

LockPersonality=yes
NoNewPrivileges=yes
ProtectHome=true
MemoryDenyWriteExecute=yes

KeyringMode=private
ProtectClock=yes
ProtectHostname=yes

ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes

RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
